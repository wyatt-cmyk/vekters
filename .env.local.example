# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so secrets never get committed.

# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# From Google Cloud Console > APIs & Services > Credentials (OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to true to force sample data even when the Google keys are filled in.
DEMO_MODE=

# Only needed for Milestone 3 (AI chat). Leave blank for now.
ANTHROPIC_API_KEY=
