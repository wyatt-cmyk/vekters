# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so secrets never get committed.

# Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# From Google Cloud Console > Google Auth Platform > Clients. See SETUP.md.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Sample data instead of a real calendar. Leave blank. In production it is
# ignored unless set to true by name, and the assistant refuses either way.
DEMO_MODE=

# From platform.claude.com > API keys. Powers the assistant and the importer.
ANTHROPIC_API_KEY=
